{
  "name": "kalpa-autoplay",
  "version": "0.1.0",
  "private": true,
  "description": "A Frida-based AutoMode research hook for KALPA 4.0.7 on Android arm64.",
  "license": "MIT",
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && frida-compile src/kalpa_overlay_agent.js -o dist/kalpa_overlay_agent.bundle.js -S",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "frida-java-bridge": "7.0.13"
  },
  "engines": {
    "node": ">=18"
  }
}
